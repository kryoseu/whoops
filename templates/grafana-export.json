{
  "uid": "whoop-export",
  "title": "Whoop — Export data (journal & workouts)",
  "tags": [
    "whoop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "description": "Data that only comes from the Whoop data export (whoop_export_* tables, imported via /import/export): journal answers and workouts. Complements 'Whoop — Recovery & Sleep Insights', which reads the API tables.",
  "templating": {
    "list": [
      {
        "name": "lag",
        "label": "Recovery lag (days)",
        "type": "custom",
        "query": "0,1",
        "current": {
          "text": "1",
          "value": "1"
        },
        "options": [
          {
            "text": "0",
            "value": "0",
            "selected": false
          },
          {
            "text": "1",
            "value": "1",
            "selected": true
          }
        ],
        "hide": 0,
        "description": "0 = recovery of the same cycle as the journal entry, 1 = the following day"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Journal",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Journal calendar",
      "type": "state-timeline",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ff0z3vnhywpogc"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ff0z3vnhywpogc"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT \"timestamp\" AS time, question AS metric, answered_yes::int AS value\nFROM whoop_export_journal\nWHERE $__timeFilter(\"timestamp\") AND answered_yes IS NOT NULL\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
            "insertNulls": 129600000,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Yes",
                  "color": "blue",
                  "index": 0
                },
                "0": {
                  "text": "No",
                  "color": "#3b3f4a",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b3f4a",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "One row per journal question, one cell per day: blue = Yes, dark = No, blank = not answered. Colours are neutral on purpose (Yes is not always the good answer)."
    },
    {
      "id": 3,
      "title": "Yes rate per question",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ff0z3vnhywpogc"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ff0z3vnhywpogc"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT question, AVG(answered_yes::int) AS \"Yes rate\"\nFROM whoop_export_journal\nWHERE $__timeFilter(\"timestamp\") AND answered_yes IS NOT NULL\nGROUP BY question\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Yes rate$/",
          "values": true
        },
        "namePlacement": "top",
        "text": {
          "valueSize": 16,
          "titleSize": 13
        }
      }
    },
    {
      "id": 4,
      "title": "What the journal does to recovery",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ff0z3vnhywpogc"
      },
      "gridPos": {
        "x": 10,
        "y": 14,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ff0z3vnhywpogc"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT j.question AS \"Question\",\n  COUNT(*) FILTER (WHERE j.answered_yes) AS \"Yes days\",\n  COUNT(*) FILTER (WHERE NOT j.answered_yes) AS \"No days\",\n  AVG(c.recovery_score) FILTER (WHERE j.answered_yes) AS \"Recovery if yes\",\n  AVG(c.recovery_score) FILTER (WHERE NOT j.answered_yes) AS \"Recovery if no\",\n  AVG(c.recovery_score) FILTER (WHERE j.answered_yes) - AVG(c.recovery_score) FILTER (WHERE NOT j.answered_yes) AS \"Δ recovery\",\n  AVG(c.hrv_rmssd_ms) FILTER (WHERE j.answered_yes) - AVG(c.hrv_rmssd_ms) FILTER (WHERE NOT j.answered_yes) AS \"Δ HRV (ms)\"\nFROM whoop_export_journal j\nJOIN whoop_export_cycle c ON c.cycle_start::date = j.cycle_start::date + ${lag}\nWHERE $__timeFilter(j.\"timestamp\") AND j.answered_yes IS NOT NULL AND c.recovery_score IS NOT NULL\nGROUP BY j.question\nORDER BY 6"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Question"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Δ.*"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": -1
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*days"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Average recovery / HRV on days where the answer was Yes versus No. Use the 'Recovery lag' variable to compare against the same cycle (0) or the next day (1). Few Yes or No days means the delta is noise."
    },
    {
      "id": 5,
      "type": "row",
      "title": "Workouts (export)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Workouts per week",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ff0z3vnhywpogc"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ff0z3vnhywpogc"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(\"timestamp\",'1w'), sport_name AS metric, COUNT(*) AS workouts\nFROM whoop_export_workout\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Workouts per sport",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ff0z3vnhywpogc"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ff0z3vnhywpogc"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sport_name AS \"Sport\", COUNT(*) AS \"Workouts\",\n  AVG(duration_ms)/60000.0 AS \"Avg min\",\n  AVG(strain) AS \"Avg strain\",\n  AVG(energy_kcal) AS \"Avg kcal\",\n  AVG(avg_heart_rate) AS \"Avg HR\",\n  AVG(max_heart_rate) AS \"Max HR\"\nFROM whoop_export_workout\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY sport_name\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Workouts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Avg HR|Max HR|Avg kcal"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "title": "Heart-rate zones per sport",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ff0z3vnhywpogc"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ff0z3vnhywpogc"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sport_name AS \"Sport\",\n  AVG(zone_one_perc) AS \"Z1\",\n  AVG(zone_two_perc) AS \"Z2\",\n  AVG(zone_three_perc) AS \"Z3\",\n  AVG(zone_four_perc) AS \"Z4\",\n  AVG(zone_five_perc) AS \"Z5\"\nFROM whoop_export_workout\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY sport_name\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Z1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8ab8ff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Z2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73bf69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Z3"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fade2a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Z4"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Z5"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f2495c"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "Sport",
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "showValue": "never",
        "barWidth": 0.8
      },
      "description": "Average share of workout time spent in each heart-rate zone."
    },
    {
      "id": 9,
      "title": "Strain per workout",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ff0z3vnhywpogc"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ff0z3vnhywpogc"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT \"timestamp\" AS time, sport_name AS metric, strain AS value\nFROM whoop_export_workout\nWHERE $__timeFilter(\"timestamp\") AND strain IS NOT NULL\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 7,
            "showPoints": "always"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "count"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
