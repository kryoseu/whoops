              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Avg HR|Max HR|Avg kcal"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ff0z3vnhywpogc"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sport_name AS \"Sport\", COUNT(*) AS \"Workouts\",\n  AVG(duration_ms)/60000.0 AS \"Avg min\",\n  AVG(strain) AS \"Avg strain\",\n  AVG(energy_kcal) AS \"Avg kcal\",\n  AVG(avg_heart_rate) AS \"Avg HR\",\n  AVG(max_heart_rate) AS \"Max HR\"\nFROM whoop_export_workout\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY sport_name\nORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "title": "Workouts per sport",
      "type": "table"
    },
